APP_NAME=yad2-scraper-service
APP_ENV=development

POSTGRES_DB=yad2
POSTGRES_USER=yad2
POSTGRES_PASSWORD=yad2
DATABASE_URL=postgresql://yad2:yad2@postgres:5432/yad2

QUEUE_URL=redis://redis:6379/0
SCRAPE_INTERVAL_SECONDS=3600
PAGES_PER_SESSION=5

# Optional Telegram notifications
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_MIN_DROP_PERCENT=5


# Optional host port overrides for local coexistence with legacy services
# API_PORT=8000
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# Dev tooling (docker compose --profile tools)
# PGADMIN_PORT=5050
# PGADMIN_DEFAULT_EMAIL=admin@local.dev
# PGADMIN_DEFAULT_PASSWORD=admin
# PORTAINER_PORT=9000
# REDISINSIGHT_PORT=5540
